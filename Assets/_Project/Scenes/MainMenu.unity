  warheads:
  - {fileID: 11400000, guid: baa0090d86908e641acb06c9749829d1, type: 2}
  - {fileID: 11400000, guid: 2c17da31972539c4d87dbd37abbf281e, type: 2}
  - {fileID: 11400000, guid: fd1535799a1a9814f8d5bd1c79413026, type: 2}
  preview: {fileID: 1272435232}
  missionNames:
  - "\u0421\u0442\u043E\u044F\u043D\u043A\u0430 \u0443 \u043F\u043E\u0441\u0430\u0434\u043A\u0438"
  - "\u041F\u0440\u0438\u043A\u0440\u044B\u0442\u0438\u0435 \u0420\u042D\u0411"
  - "\u041E\u0433\u043D\u0435\u0432\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438"
  - "\u041A\u043E\u043B\u043E\u043D\u043D\u0430"
  - "\u041F\u043E\u0437\u0438\u0446\u0438\u044F \u0417\u0420\u041A"
  - "\u041B\u043E\u0436\u043D\u044B\u0435 \u0446\u0435\u043B\u0438"
  - "\u041D\u043E\u0447\u043D\u0430\u044F \u043E\u0445\u043E\u0442\u0430"
  - "\u041E\u0445\u043E\u0442\u0430 \u043D\u0430 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442"
  missionScenes:
  - Mission_01
  - Mission_02
  - Mission_03
  - Mission_04
  - Mission_05
  - Mission_06
  - Mission_07
  - Mission_08
  missionBriefings:
  - "\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430 \u0431\u0440\u043E\u043D\u0435\u0442\u0435\u0445\u043D\u0438\u043A\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432 330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u0432\u0437\u043B\u0451\u0442\u0430 (\u043A\u0443\u0440\u0441 000).\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0432\u0441\u0435 \u0442\u0440\u0438 \u0442\u0430\u043D\u043A\u0430.\n\n\u041B\u043E\u0431\u043E\u0432\u0430\u044F \u0431\u0440\u043E\u043D\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u0430 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u2014 \u0438\u0449\u0438\u0442\u0435 \u0431\u043E\u0440\u0442, \u043A\u043E\u0440\u043C\u0443, \u043A\u0440\u044B\u0448\u0443 \u043C\u043E\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u043E\u0442\u0441\u0435\u043A\u0430 \u0438 \u0431\u0430\u0448\u043D\u0438. \u0412\u0437\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u044C \u0432\u0437\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 2 \u0441 \u043F\u043E\u0441\u043B\u0435 \u0430\u0440\u043C\u0430."
  - "\u0414\u0432\u0430 \u0442\u0430\u043D\u043A\u0430 \u0443 \u0442\u043E\u0439 \u0436\u0435 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044B \u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439 \u0420\u042D\u0411: \u043E\u043D\u0430 \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432 280 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u0432\u0437\u043B\u0451\u0442\u0430, \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u0430\u0434\u043A\u043E\u0439.\n\n\u0420\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439 \u0440\u0430\u0434\u0438\u043E\u043A\u0430\u043D\u0430\u043B \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u2014 \u0432\u0438\u0434\u0435\u043E \u0432 \xAB\u0441\u043D\u0435\u0433\u0443\xBB, \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u0435\u0442, \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D failsafe.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u044E \u0420\u042D\u0411 (\u0430\u043D\u0442\u0435\u043D\u043D\u044B \u043D\u0430 \u043C\u0430\u0447\u0442\u0435 \u0438\u043B\u0438 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0432 \u043A\u0443\u043D\u0433\u0435) \u0438 \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u043E\u0431\u0430 \u0442\u0430\u043D\u043A\u0430. \u041E\u043F\u0442\u043E\u0432\u043E\u043B\u043E\u043A\u043E\u043D\u043D\u044B\u0435 \u0434\u0440\u043E\u043D\u044B \u0420\u042D\u0411 \u043D\u0435 \u0433\u043B\u0443\u0448\u0438\u0442, \u043D\u043E \u0438\u0445 \u0432\u0441\u0435\u0433\u043E \u0434\u0432\u0430."
  - "\u0417\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0432 ~350 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u2014 \u043E\u0433\u043D\u0435\u0432\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438: \u0421\u0410\u0423 \u0438 \u0434\u0432\u0435 \u0431\u0443\u043A\u0441\u0438\u0440\u0443\u0435\u043C\u044B\u0435 \u0433\u0430\u0443\u0431\u0438\u0446\u044B. \u0418\u0445 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432.\n\n\u0420\u0430\u0441\u0447\u0451\u0442 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0434\u0440\u043E\u043D \u043D\u0430\u0434 \u043F\u043E\u0441\u0430\u0434\u043A\u043E\u0439 \u0438 \u0432\u044B\u0448\u0435 ~5 \u043C \u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A. \u041E\u043D \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0448\u0438\u0440\u0435: \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0440\u0435\u0437\u043A\u0438\u043C \u043C\u0430\u043D\u0451\u0432\u0440\u043E\u043C, \u043D\u044B\u0440\u044F\u0439\u0442\u0435 \u0432 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u0443, \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C \u043D\u0438\u0437\u043A\u043E. \u0412\u044B\u0431\u0435\u0439\u0442\u0435 \u0430\u043D\u0442\u0435\u043D\u043D\u0443 \u043D\u0430 \u043C\u0430\u0447\u0442\u0435 \u0438\u043B\u0438 \u043F\u043E\u0441\u0442 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u2014 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F \u0431\u0435\u0437 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\n\n\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442 \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043C\u0430\u043A\u0435\u0442\u0430\u0445 \u0442\u0435\u0445\u043D\u0438\u043A\u0438. \u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0411\u0427 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430 \u043F\u043E \u043E\u0440\u0443\u0434\u0438\u044F\u043C \u0438 \u0440\u0430\u0441\u0447\u0451\u0442\u0443, \u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u0430\u044F \u2014 \u043F\u043E \u0431\u0440\u043E\u043D\u0435."
  - "\u041F\u043E \u0433\u0440\u0443\u043D\u0442\u043E\u0432\u043A\u0435 \u0437\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439, \u0432 ~500 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u0441 \u0437\u0430\u043F\u0430\u0434\u0430 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A \u0438\u0434\u0451\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u0430: \u0431\u0440\u043E\u043D\u0435\u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C \xAB\u0422\u0430\u0439\u0444\u0443\u043D\xBB, \u0411\u0422\u0420, \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u0420\u0421\u0417\u041E, \u043F\u0443\u0441\u043A\u043E\u0432\u0430\u044F \u0421-400 \u043D\u0430 \u043C\u0430\u0440\u0448\u0435 \u0438 \u0442\u0430\u043D\u043A.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F 3 \u043C\u0430\u0448\u0438\u043D\u044B \u0438\u0437 6, \u043F\u043E\u043A\u0430 \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u043D\u0435 \u0443\u0448\u043B\u0430. \u041F\u043E\u0434\u0431\u0438\u0442\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430 \u0432\u0441\u0442\u0430\u0451\u0442 \u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445; \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442\u0441\u044F \u0438 \u0441\u0442\u0430\u0432\u0438\u0442 \u0434\u044B\u043C.\n\n\u0414\u0432\u0430 \u0443\u0447\u0430\u0441\u0442\u043A\u0430 \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0434\u0440\u043E\u043D\u043E\u0432\u044B\u043C\u0438 \u0441\u0435\u0442\u043A\u0430\u043C\u0438 \u2014 \u0432 \u0441\u0435\u0442\u043A\u0435 \u0434\u0440\u043E\u043D \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0435\u0442 \u0438 \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0435 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u043D\u043E \u0432 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u0440\u0430\u0437\u0440\u044B\u0432\u044B. \u0412 \u043A\u043E\u043B\u043E\u043D\u043D\u0435 \u0438\u0434\u0451\u0442 \u0417\u0418\u041B \u0441 \u0414\u0428\u041A (\u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430), \u0434\u043E\u0440\u043E\u0433\u0443 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432. \u041A\u043E\u043B\u043E\u043D\u043D\u0430 \u0442\u0440\u043E\u043D\u0435\u0442\u0441\u044F \u0441 \u0432\u0430\u0448\u0438\u043C \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u0437\u043B\u0451\u0442\u043E\u043C."
  - "\u0417\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439, \u0432 ~800 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F \u0417\u0420\u041A: \u0420\u041B\u0421, \u0434\u0432\u0435 \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0438\u0445 \u0417\u0420\u041F\u041A.\n\n\u041F\u043E\u0434\u0445\u043E\u0434 \u0433\u043B\u0443\u0448\u0438\u0442 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0420\u042D\u0411, \u043D\u0430\u0434 \u043F\u043E\u0437\u0438\u0446\u0438\u0435\u0439 \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432. \u041E\u043F\u0442\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u043E \u043D\u0435 \u0433\u043B\u0443\u0448\u0438\u0442\u0441\u044F, \u043D\u043E \u043A\u0430\u0442\u0443\u0448\u043A\u0438 \u0445\u0432\u0430\u0442\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u0440\u044F\u043C\u043E\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F 3 \u0446\u0435\u043B\u0438 \u0438\u0437 5 (\u0420\u041B\u0421 \u0438 \u0420\u042D\u0411 \u2014 \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C, \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0438 \u0417\u0420\u041F\u041A \u2014 \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F)."
  - "\u0412\u0434\u043E\u043B\u044C \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u0432 ~330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u0441\u0442\u043E\u0438\u0442 \u0442\u0435\u0445\u043D\u0438\u043A\u0430: \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u043D\u0430\u0441\u0447\u0438\u0442\u0430\u043B\u0430 \u0432\u043E\u0441\u0435\u043C\u044C \u043C\u0430\u0448\u0438\u043D, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u2014 \u043D\u0430\u0434\u0443\u0432\u043D\u044B\u0435 \u043C\u0430\u043A\u0435\u0442\u044B.\n\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0442\u0440\u0438: \u0421\u0410\u0423, \u0420\u0421\u0417\u041E \u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A. \u041C\u0430\u043A\u0435\u0442\u044B \u0431\u043B\u0435\u0441\u0442\u044F\u0442, \u0443 \u043D\u0438\u0445 \u0443\u043F\u0440\u043E\u0449\u0451\u043D\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B \u0438 \u043B\u0451\u0433\u043A\u0438\u0439 \u043A\u0440\u0435\u043D. \u041F\u043E\u0437\u0438\u0446\u0438\u044E \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0432\u0441\u0435 \u0442\u0440\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u043C\u0430\u0448\u0438\u043D\u044B. \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u043F\u043E \u043C\u0430\u043A\u0435\u0442\u0443 \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u0434\u0440\u043E\u043D."
  - "\u041D\u043E\u0447\u044C. \u0422\u0435\u0445\u043D\u0438\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u0432 ~330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443. \u0414\u0440\u043E\u043D\u044B \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u044B \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u043E\u0440\u0430\u043C\u0438 (384x288, \u0443\u0437\u043A\u0438\u0439 \u0443\u0433\u043E\u043B \u043E\u0431\u0437\u043E\u0440\u0430, \xAB\u0431\u0435\u043B\u043E\u0435 \u2014 \u0433\u043E\u0440\u044F\u0447\u0435\u0435\xBB): \u0442\u0451\u043F\u043B\u044B\u0435 \u043C\u043E\u0442\u043E\u0440\u044B \u0432\u0438\u0434\u043D\u044B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0437\u0435\u043C\u043B\u044F \u043F\u043E\u0447\u0442\u0438 \u0447\u0451\u0440\u043D\u0430\u044F.\n\n\u0421\u0440\u0435\u0434\u0438 \u0446\u0435\u043B\u0435\u0439 \u0435\u0441\u0442\u044C \u043D\u0430\u0434\u0443\u0432\u043D\u044B\u0435 \u043C\u0430\u043A\u0435\u0442\u044B \u2014 \u043E\u043D\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0438 \u043D\u0430 \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u043E\u0440\u0435 \u043D\u0435 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0442\u0430\u043D\u043A, \u0420\u0421\u0417\u041E \u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A. \u0417\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432."
  - "\u0423\u0434\u0430\u0440\u043D\u044B\u0439 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442 \u041C\u0438-28\u041D\u041C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u043E \u043D\u0430\u0448\u0438\u043C \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C: \u043D\u0438\u0437\u043A\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u0436\u0434\u0443 \u043E\u0433\u043D\u0435\u0432\u044B\u043C\u0438 \u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u0432 0,8\u20131 \u043A\u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u0438 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442 \u043D\u0430 ~20 \u0441\u0435\u043A\u0443\u043D\u0434, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C\u0441\u044F.\n\n\u0414\u043E\u0433\u043D\u0430\u0442\u044C \u0435\u0433\u043E \u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442 \u2014 \u043B\u043E\u0432\u0438\u0442\u0435 \u043D\u0430 \u0437\u0430\u0432\u0438\u0441\u0430\u043D\u0438\u0438. \u0423\u044F\u0437\u0432\u0438\u043C\u044B\u0435 \u043C\u0435\u0441\u0442\u0430: \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0432\u0438\u043D\u0442 \u0438 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u0430\u044F \u0431\u0430\u043B\u043A\u0430, \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438 \u043D\u0430\u0434 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u043D\u0435\u0441\u0443\u0449\u0438\u0439 \u0432\u0438\u043D\u0442. \u041A\u0430\u0431\u0438\u043D\u0430 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0430.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0441\u0431\u0438\u0442\u044C \u041C\u0438-28\u041D\u041C."

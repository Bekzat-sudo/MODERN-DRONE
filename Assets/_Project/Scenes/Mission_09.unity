--- !u!114 &328508833
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 328508830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 9: \u0411\u0430\u0442\u0430\u0440\u0435\u044F \u041F\u0412\u041E"
  briefing: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u041F\u0412\u041E. \u041C\u0435\u0436\u0434\u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438, \u0432 ~1,3\u20131,5 \u043A\u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u043F\u0443\u0441\u043A\u0430, \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0430 \u043F\u043E\u043B\u0435\u0432\u0430\u044F \u0431\u0430\u0442\u0430\u0440\u0435\u044F \u0417\u0420\u041A \u0421-400. \u0412\u043F\u0435\u0440\u0435\u0434\u0438, \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043F\u043E\u043B\u0435, \u2014 \u0420\u041B\u0421; \u0437\u0430 \u043D\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043F\u0443\u043D\u043A\u0442 \u0441 \u0430\u043D\u0442\u0435\u043D\u043D\u044B\u043C\u0438 \u043C\u0430\u0447\u0442\u0430\u043C\u0438; \u0447\u0435\u0442\u044B\u0440\u0435 \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0440\u0430\u0441\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u044B \u043F\u043E \u0437\u0435\u043C\u043B\u044F\u043D\u044B\u043C \u043A\u0430\u043F\u043E\u043D\u0438\u0440\u0430\u043C; \u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u2014 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E-\u0437\u0430\u0440\u044F\u0436\u0430\u044E\u0449\u0438\u0435 \u043C\u0430\u0448\u0438\u043D\u044B \u0438 \u0442\u0435\u0445\u0437\u043E\u043D\u0430. \u0424\u043B\u0430\u043D\u0433 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \xAB\u041F\u0430\u043D\u0446\u0438\u0440\u044C-\u04211\xBB, \u0441 \u0437\u0430\u043F\u0430\u0434\u0430 \u2014 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430 \u0441 \u0417\u0423-23.\n\n\u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442 Hornet \u2014 \u0443\u0434\u0430\u0440\u043D\u044B\u0439 \u0434\u0440\u043E\u043D-\u0441\u0430\u043C\u043E\u043B\u0451\u0442 \u0441 \u0431\u043E\u0435\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E 5 \u043A\u0433 \u0438 \u0441\u0432\u044F\u0437\u044C\u044E \u0447\u0435\u0440\u0435\u0437 Starlink: \u0420\u042D\u0411 \u0435\u0433\u043E \u043D\u0435 \u0433\u043B\u0443\u0448\u0438\u0442. \u041E\u043D \u0441\u0442\u0430\u0440\u0442\u0443\u0435\u0442 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u043D\u0430 ~250 \u043C \u0438 ~110 \u043A\u043C/\u0447. \u0421\u0430\u043C\u043E\u043B\u0451\u0442 \u043D\u0435 \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442: \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435, \u0446\u0435\u043B\u044C \u0431\u0435\u0440\u0438\u0442\u0435 \u0432 \u043F\u0438\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438 (200\u2013300 \u043A\u043C/\u0447); \u043D\u0438\u0436\u0435 ~70 \u043A\u043C/\u0447 \u043A\u0440\u044B\u043B\u043E \u0441\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F. \u041F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0432 \u043A\u0430\u043F\u043E\u043D\u0438\u0440\u0430\u0445 \u2014 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0441\u0432\u0435\u0440\u0445\u0443 \u0438\u043B\u0438 \u0441\u0437\u0430\u0434\u0438, \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0432\u044A\u0435\u0437\u0434\u0430. \u041A\u0430\u0436\u0434\u044B\u0439 Hornet \u043E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0439.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u044E \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u2014 4 \u0446\u0435\u043B\u0438 \u0438\u0437 6 (\u0420\u041B\u0421 \u2014 \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C, \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0438 \xAB\u041F\u0430\u043D\u0446\u0438\u0440\u044C\xBB \u2014 \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F)."
  sorties: 6
  fiberSorties: 0
  warheads:
  - {fileID: 11400000, guid: 9dfd1a5576eb79943ab9412306c0d9e9, type: 2}
  droneModels:
  - {fileID: 11400000, guid: 36fa569778e408a459182bec89ded451, type: 2}
  parts: []
  requiredTargets: 4
  drone: {fileID: 0}
  killcam: {fileID: 0}
  droneLostDelay: 2

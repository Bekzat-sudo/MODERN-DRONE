--- !u!114 &1296515931
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1296515927}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 7: \u041D\u043E\u0447\u043D\u0430\u044F \u043E\u0445\u043E\u0442\u0430"
  briefing: "\u041D\u043E\u0447\u044C. \u0422\u0435\u0445\u043D\u0438\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u0432 ~330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443. \u0414\u0440\u043E\u043D\u044B \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u044B \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u043E\u0440\u0430\u043C\u0438 (384x288, \u0443\u0437\u043A\u0438\u0439 \u0443\u0433\u043E\u043B \u043E\u0431\u0437\u043E\u0440\u0430, \xAB\u0431\u0435\u043B\u043E\u0435 \u2014 \u0433\u043E\u0440\u044F\u0447\u0435\u0435\xBB): \u0442\u0451\u043F\u043B\u044B\u0435 \u043C\u043E\u0442\u043E\u0440\u044B \u0432\u0438\u0434\u043D\u044B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0437\u0435\u043C\u043B\u044F \u043F\u043E\u0447\u0442\u0438 \u0447\u0451\u0440\u043D\u0430\u044F.\n\n\u0421\u0440\u0435\u0434\u0438 \u0446\u0435\u043B\u0435\u0439 \u0435\u0441\u0442\u044C \u043D\u0430\u0434\u0443\u0432\u043D\u044B\u0435 \u043C\u0430\u043A\u0435\u0442\u044B \u2014 \u043E\u043D\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0438 \u043D\u0430 \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u043E\u0440\u0435 \u043D\u0435 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0442\u0430\u043D\u043A, \u0420\u0421\u0417\u041E \u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A. \u0417\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432."
  sorties: 4

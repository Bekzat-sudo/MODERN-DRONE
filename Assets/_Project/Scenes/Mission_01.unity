  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 1: \u0421\u0442\u043E\u044F\u043D\u043A\u0430 \u0443 \u043F\u043E\u0441\u0430\u0434\u043A\u0438"
  briefing: "\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430 \u0431\u0440\u043E\u043D\u0435\u0442\u0435\u0445\u043D\u0438\u043A\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0443 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432 330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u0432\u0437\u043B\u0451\u0442\u0430 (\u043A\u0443\u0440\u0441 000).\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0432\u0441\u0435 \u0442\u0440\u0438 \u0442\u0430\u043D\u043A\u0430.\n\n\u041B\u043E\u0431\u043E\u0432\u0430\u044F \u0431\u0440\u043E\u043D\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u0430 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u2014 \u0438\u0449\u0438\u0442\u0435 \u0431\u043E\u0440\u0442, \u043A\u043E\u0440\u043C\u0443, \u043A\u0440\u044B\u0448\u0443 \u043C\u043E\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u043E\u0442\u0441\u0435\u043A\u0430 \u0438 \u0431\u0430\u0448\u043D\u0438. \u0412\u0437\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u044C \u0432\u0437\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 2 \u0441 \u043F\u043E\u0441\u043B\u0435 \u0430\u0440\u043C\u0430."
  sorties: 4

--- !u!114 &1098056222
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1098056220}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 4: \u041A\u043E\u043B\u043E\u043D\u043D\u0430"
  briefing: "\u041F\u043E \u0433\u0440\u0443\u043D\u0442\u043E\u0432\u043A\u0435 \u0437\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439, \u0432 ~500 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u0441 \u0437\u0430\u043F\u0430\u0434\u0430 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A \u0438\u0434\u0451\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u0430: \u0411\u0422\u0420, \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u0420\u0421\u0417\u041E \u0438 \u0442\u0430\u043D\u043A.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F 3 \u043C\u0430\u0448\u0438\u043D\u044B \u0438\u0437 4, \u043F\u043E\u043A\u0430 \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u043D\u0435 \u0443\u0448\u043B\u0430. \u041F\u043E\u0434\u0431\u0438\u0442\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430 \u0432\u0441\u0442\u0430\u0451\u0442 \u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445; \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043A\u043E\u043B\u043E\u043D\u043D\u0430 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442\u0441\u044F \u0438 \u0441\u0442\u0430\u0432\u0438\u0442 \u0434\u044B\u043C.\n\n\u0414\u0432\u0430 \u0443\u0447\u0430\u0441\u0442\u043A\u0430 \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0434\u0440\u043E\u043D\u043E\u0432\u044B\u043C\u0438 \u0441\u0435\u0442\u043A\u0430\u043C\u0438 \u2014 \u0434\u0440\u043E\u043D \u043F\u043E\u0434\u043E\u0440\u0432\u0451\u0442\u0441\u044F \u043D\u0430 \u0441\u0435\u0442\u043A\u0435, \u043D\u043E \u0432 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u0440\u0430\u0437\u0440\u044B\u0432\u044B. \u0422\u0435\u0445\u043D\u0438\u043A\u0430 \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u0431\u043B\u0438\u0437\u0438 (\u0434\u043E ~50 \u043C), \u0434\u043E\u0440\u043E\u0433\u0443 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432. \u041A\u043E\u043B\u043E\u043D\u043D\u0430 \u0442\u0440\u043E\u043D\u0435\u0442\u0441\u044F \u0441 \u0432\u0430\u0448\u0438\u043C \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u0437\u043B\u0451\u0442\u043E\u043C."
  sorties: 5
  fiberSorties: 1
  warheads:
  - {fileID: 11400000, guid: baa0090d86908e641acb06c9749829d1, type: 2}
  - {fileID: 11400000, guid: 2c17da31972539c4d87dbd37abbf281e, type: 2}
  - {fileID: 11400000, guid: fd1535799a1a9814f8d5bd1c79413026, type: 2}

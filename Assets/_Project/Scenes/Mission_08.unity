MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 595527791}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 8: \u041E\u0445\u043E\u0442\u0430 \u043D\u0430 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442"
  briefing: "\u0423\u0434\u0430\u0440\u043D\u044B\u0439 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442 \u041C\u0438-28\u041D\u041C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u043E \u043D\u0430\u0448\u0438\u043C \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C: \u043D\u0438\u0437\u043A\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u0436\u0434\u0443 \u043E\u0433\u043D\u0435\u0432\u044B\u043C\u0438 \u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u0432 0,8\u20131 \u043A\u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u0438 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442 \u043D\u0430 ~20 \u0441\u0435\u043A\u0443\u043D\u0434, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C\u0441\u044F.\n\n\u0414\u043E\u0433\u043D\u0430\u0442\u044C \u0435\u0433\u043E \u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442 \u2014 \u043B\u043E\u0432\u0438\u0442\u0435 \u043D\u0430 \u0437\u0430\u0432\u0438\u0441\u0430\u043D\u0438\u0438. \u0423\u044F\u0437\u0432\u0438\u043C\u044B\u0435 \u043C\u0435\u0441\u0442\u0430: \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0432\u0438\u043D\u0442 \u0438 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u0430\u044F \u0431\u0430\u043B\u043A\u0430, \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438 \u043D\u0430\u0434 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u043D\u0435\u0441\u0443\u0449\u0438\u0439 \u0432\u0438\u043D\u0442. \u041A\u0430\u0431\u0438\u043D\u0430 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0430.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0441\u0431\u0438\u0442\u044C \u041C\u0438-28\u041D\u041C."
  sorties: 4
  fiberSorties: 0
  warheads:

  m_GameObject: {fileID: 1763783780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 3: \u041E\u0433\u043D\u0435\u0432\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438"
  briefing: "\u0417\u0430 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0432 ~350 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u2014 \u043E\u0433\u043D\u0435\u0432\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438: \u0421\u0410\u0423 \u0438 \u0434\u0432\u0435 \u0431\u0443\u043A\u0441\u0438\u0440\u0443\u0435\u043C\u044B\u0435 \u0433\u0430\u0443\u0431\u0438\u0446\u044B. \u0418\u0445 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432.\n\n\u0420\u0430\u0441\u0447\u0451\u0442 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0434\u0440\u043E\u043D \u043D\u0430\u0434 \u043F\u043E\u0441\u0430\u0434\u043A\u043E\u0439 \u0438 \u0432\u044B\u0448\u0435 ~5 \u043C \u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A. \u041E\u043D \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0448\u0438\u0440\u0435: \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0440\u0435\u0437\u043A\u0438\u043C \u043C\u0430\u043D\u0451\u0432\u0440\u043E\u043C, \u043D\u044B\u0440\u044F\u0439\u0442\u0435 \u0432 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u0443, \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C \u043D\u0438\u0437\u043A\u043E. \u0412\u044B\u0431\u0435\u0439\u0442\u0435 \u0430\u043D\u0442\u0435\u043D\u043D\u0443 \u043D\u0430 \u043C\u0430\u0447\u0442\u0435 \u0438\u043B\u0438 \u043F\u043E\u0441\u0442 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u2014 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F \u0431\u0435\u0437 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\n\n\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442 \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043C\u0430\u043A\u0435\u0442\u0430\u0445 \u0442\u0435\u0445\u043D\u0438\u043A\u0438. \u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0411\u0427 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430 \u043F\u043E \u043E\u0440\u0443\u0434\u0438\u044F\u043C \u0438 \u0440\u0430\u0441\u0447\u0451\u0442\u0443, \u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u0430\u044F \u2014 \u043F\u043E \u0431\u0440\u043E\u043D\u0435."
  sorties: 5
  fiberSorties: 1
  warheads:
  - {fileID: 11400000, guid: baa0090d86908e641acb06c9749829d1, type: 2}
  - {fileID: 11400000, guid: 2c17da31972539c4d87dbd37abbf281e, type: 2}

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 5: \u041F\u043E\u0437\u0438\u0446\u0438\u044F \u0417\u0420\u041A"
  briefing: "\u0417\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u043E\u0439, \u0432 ~800 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F \u0417\u0420\u041A: \u0420\u041B\u0421, \u0434\u0432\u0435 \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0438\u0445 \u0417\u0420\u041F\u041A.\n\n\u041F\u043E\u0434\u0445\u043E\u0434 \u0433\u043B\u0443\u0448\u0438\u0442 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0420\u042D\u0411, \u043D\u0430\u0434 \u043F\u043E\u0437\u0438\u0446\u0438\u0435\u0439 \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u0440\u0430\u0441\u0447\u0451\u0442 \u0434\u0440\u043E\u043D\u043E\u0432-\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432. \u041E\u043F\u0442\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u043E \u043D\u0435 \u0433\u043B\u0443\u0448\u0438\u0442\u0441\u044F, \u043D\u043E \u043A\u0430\u0442\u0443\u0448\u043A\u0438 \u0445\u0432\u0430\u0442\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u0440\u044F\u043C\u043E\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F 3 \u0446\u0435\u043B\u0438 \u0438\u0437 5 (\u0420\u041B\u0421 \u0438 \u0420\u042D\u0411 \u2014 \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C, \u043F\u0443\u0441\u043A\u043E\u0432\u044B\u0435 \u0438 \u0417\u0420\u041F\u041A \u2014 \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F)."
  sorties: 3
  fiberSorties: 3
  warheads:

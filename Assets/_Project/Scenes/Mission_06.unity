--- !u!114 &743962251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 743962248}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03eb2beac1408c34caa7b78f1bd9c852, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ModernDrone.Missions::ModernDrone.Missions.MissionController
  missionName: "\u0417\u0430\u0434\u0430\u0447\u0430 6: \u041B\u043E\u0436\u043D\u044B\u0435 \u0446\u0435\u043B\u0438"
  briefing: "\u0412\u0434\u043E\u043B\u044C \u043B\u0435\u0441\u043E\u043F\u043E\u043B\u043E\u0441\u044B \u0432 ~330 \u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u0441\u0442\u043E\u0438\u0442 \u0442\u0435\u0445\u043D\u0438\u043A\u0430: \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u043D\u0430\u0441\u0447\u0438\u0442\u0430\u043B\u0430 \u0432\u043E\u0441\u0435\u043C\u044C \u043C\u0430\u0448\u0438\u043D, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u2014 \u043D\u0430\u0434\u0443\u0432\u043D\u044B\u0435 \u043C\u0430\u043A\u0435\u0442\u044B.\n\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0442\u0440\u0438: \u0421\u0410\u0423, \u0420\u0421\u0417\u041E \u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A. \u041C\u0430\u043A\u0435\u0442\u044B \u0431\u043B\u0435\u0441\u0442\u044F\u0442, \u0443 \u043D\u0438\u0445 \u0443\u043F\u0440\u043E\u0449\u0451\u043D\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B \u0438 \u043B\u0451\u0433\u043A\u0438\u0439 \u043A\u0440\u0435\u043D. \u041F\u043E\u0437\u0438\u0446\u0438\u044E \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F \u043E\u0433\u043D\u0435\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430.\n\n\u0417\u0430\u0434\u0430\u0447\u0430: \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F \u0432\u0441\u0435 \u0442\u0440\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u043C\u0430\u0448\u0438\u043D\u044B. \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u043F\u043E \u043C\u0430\u043A\u0435\u0442\u0443 \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u0434\u0440\u043E\u043D."
  sorties: 5
  fiberSorties: 0
  warheads:
  - {fileID: 11400000, guid: baa0090d86908e641acb06c9749829d1, type: 2}
  - {fileID: 11400000, guid: 2c17da31972539c4d87dbd37abbf281e, type: 2}
